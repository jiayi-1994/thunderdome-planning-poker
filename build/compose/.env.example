# Run `sh init-env.sh` to create .env with random credentials.
# For manual setup, copy this file to .env and fill all three secrets.
APP_DOMAIN=localhost
APP_HTTPS=false
HTTP_PORT=8080
HTTP_WRITE_TIMEOUT=60
BIND_ADDRESS=0.0.0.0
ADMIN_EMAIL=

DB_PASSWORD=
COOKIE_HASHKEY=
CONFIG_AES_HASHKEY=

# Domestic mirrors (default):
APP_IMAGE=ghcr.nju.edu.cn/jiayi-1994/thunderdome-planning-poker:latest
POSTGRES_IMAGE=m.daocloud.io/docker.io/library/postgres:17-bookworm

# Direct registries, or replace these with your Harbor repositories:
# APP_IMAGE=ghcr.io/jiayi-1994/thunderdome-planning-poker:latest
# POSTGRES_IMAGE=docker.io/library/postgres:17-bookworm
